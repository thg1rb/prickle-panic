{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prickle-panic:protocol:v1:message-schema",
  "title": "Prickle Panic protocol v1 message",
  "oneOf": [
    { "$ref": "#/$defs/clientRequest" },
    { "$ref": "#/$defs/serverEvent" },
    { "$ref": "#/$defs/serverError" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "version": { "const": 1 },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "roomCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12,
      "pattern": "^[A-Z0-9]+$"
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardId", "variant"],
      "properties": {
        "cardId": { "$ref": "#/$defs/id" },
        "variant": { "type": "integer", "minimum": 0, "maximum": 31 }
      }
    },
    "roomPlayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "username", "ready", "isHost"],
      "properties": {
        "playerId": { "$ref": "#/$defs/id" },
        "username": { "type": "string", "minLength": 1, "maxLength": 256 },
        "ready": { "type": "boolean" },
        "isHost": { "type": "boolean" }
      }
    },
    "scoreEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "score"],
      "properties": {
        "playerId": { "$ref": "#/$defs/id" },
        "score": { "type": "integer", "minimum": 0 }
      }
    },
    "clientRequest": {
      "oneOf": [
        { "$ref": "#/$defs/roomCreate" },
        { "$ref": "#/$defs/roomJoin" },
        { "$ref": "#/$defs/roomLeave" },
        { "$ref": "#/$defs/roomReady" },
        { "$ref": "#/$defs/matchStart" },
        { "$ref": "#/$defs/cardPick" },
        { "$ref": "#/$defs/snapshotRequest" }
      ]
    },
    "requestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "requestId", "payload"],
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "type": { "type": "string" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "payload": { "type": "object" }
      }
    },
    "roomCreate": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "room.create" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            }
          }
        }
      ]
    },
    "roomJoin": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "room.join" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["roomCode"],
              "properties": { "roomCode": { "$ref": "#/$defs/roomCode" } }
            }
          }
        }
      ]
    },
    "roomLeave": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "room.leave" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            }
          }
        }
      ]
    },
    "roomReady": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "room.set_ready" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ready"],
              "properties": { "ready": { "type": "boolean" } }
            }
          }
        }
      ]
    },
    "matchStart": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "match.start" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            }
          }
        }
      ]
    },
    "cardPick": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "game.pick_card" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "matchId",
                "cardId",
                "boardVersion",
                "referenceVersion"
              ],
              "properties": {
                "matchId": { "$ref": "#/$defs/id" },
                "cardId": { "$ref": "#/$defs/id" },
                "boardVersion": { "type": "integer", "minimum": 0 },
                "referenceVersion": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      ]
    },
    "snapshotRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "state.request_snapshot" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["afterSeq"],
              "properties": { "afterSeq": { "type": "integer", "minimum": 0 } }
            }
          }
        }
      ]
    },
    "serverEvent": {
      "oneOf": [
        { "$ref": "#/$defs/roomSnapshot" },
        { "$ref": "#/$defs/roomUpdated" },
        { "$ref": "#/$defs/gameSnapshot" },
        { "$ref": "#/$defs/gameStarted" },
        { "$ref": "#/$defs/boardUpdated" },
        { "$ref": "#/$defs/actionResult" },
        { "$ref": "#/$defs/scoreUpdated" },
        { "$ref": "#/$defs/matchEnded" }
      ]
    },
    "serverEventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "seq", "payload"],
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "type": { "type": "string" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "seq": { "type": "integer", "minimum": 1 },
        "payload": { "type": "object" }
      }
    },
    "roomSnapshot": {
      "allOf": [
        { "$ref": "#/$defs/serverEventEnvelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "room.snapshot" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["roomId", "roomCode", "hostPlayerId", "players"],
              "properties": {
                "roomId": { "$ref": "#/$defs/id" },
                "roomCode": { "$ref": "#/$defs/roomCode" },
                "hostPlayerId": { "$ref": "#/$defs/id" },
                "players": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "items": { "$ref": "#/$defs/roomPlayer" }
                }
              }
            }
          }
        }
      ]
    },
    "roomUpdated": {
      "allOf": [
        { "$ref": "#/$defs/serverEventEnvelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "room.updated" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["roomId", "players"],
              "properties": {
                "roomId": { "$ref": "#/$defs/id" },
                "players": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "items": { "$ref": "#/$defs/roomPlayer" }
                }
              }
            }
          }
        }
      ]
    },
    "gameSnapshot": {
      "allOf": [
        { "$ref": "#/$defs/serverEventEnvelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "game.snapshot" },
            "payload": { "$ref": "#/$defs/privateGameState" }
          }
        }
      ]
    },
    "privateGameState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matchId",
        "mode",
        "boardVersion",
        "referenceVersion",
        "cards",
        "referenceCard",
        "self",
        "scores"
      ],
      "properties": {
        "matchId": { "$ref": "#/$defs/id" },
        "mode": { "const": "speed_battle" },
        "boardVersion": { "type": "integer", "minimum": 0 },
        "referenceVersion": { "type": "integer", "minimum": 0 },
        "cards": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/card" }
        },
        "referenceCard": { "$ref": "#/$defs/card" },
        "self": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playerId", "score"],
          "properties": {
            "playerId": { "$ref": "#/$defs/id" },
            "score": { "type": "integer", "minimum": 0 }
          }
        },
        "scores": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/scoreEntry" }
        }
      }
    },
    "gameStarted": {
      "allOf": [
        { "$ref": "#/$defs/serverEventEnvelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "game.started" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["matchId", "mode", "startedAt", "endsAt"],
              "properties": {
                "matchId": { "$ref": "#/$defs/id" },
                "mode": { "const": "speed_battle" },
                "startedAt": { "type": "string", "format": "date-time" },
                "endsAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      ]
    },
    "boardUpdated": {
      "allOf": [
        { "$ref": "#/$defs/serverEventEnvelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "game.board.updated" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "matchId",
                "boardVersion",
                "referenceVersion",
                "cards",
                "referenceCard"
              ],
              "properties": {
                "matchId": { "$ref": "#/$defs/id" },
                "boardVersion": { "type": "integer", "minimum": 0 },
                "referenceVersion": { "type": "integer", "minimum": 0 },
                "cards": {
                  "type": "array",
                  "minItems": 16,
                  "maxItems": 16,
                  "items": { "$ref": "#/$defs/card" }
                },
                "referenceCard": { "$ref": "#/$defs/card" }
              }
            }
          }
        }
      ]
    },
    "actionResult": {
      "allOf": [
        { "$ref": "#/$defs/serverEventEnvelope" },
        {
          "type": "object",
          "required": ["requestId"],
          "properties": {
            "type": { "const": "game.action.result" },
            "requestId": { "$ref": "#/$defs/requestId" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "matchId",
                "accepted",
                "boardVersion",
                "referenceVersion"
              ],
              "properties": {
                "matchId": { "$ref": "#/$defs/id" },
                "accepted": { "type": "boolean" },
                "boardVersion": { "type": "integer", "minimum": 0 },
                "referenceVersion": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      ]
    },
    "scoreUpdated": {
      "allOf": [
        { "$ref": "#/$defs/serverEventEnvelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "game.score.updated" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["matchId", "scores"],
              "properties": {
                "matchId": { "$ref": "#/$defs/id" },
                "scores": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 6,
                  "items": { "$ref": "#/$defs/scoreEntry" }
                }
              }
            }
          }
        }
      ]
    },
    "matchEnded": {
      "allOf": [
        { "$ref": "#/$defs/serverEventEnvelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "game.match.ended" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["matchId", "scores", "winnerIds"],
              "properties": {
                "matchId": { "$ref": "#/$defs/id" },
                "scores": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 6,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["playerId", "score", "rank"],
                    "properties": {
                      "playerId": { "$ref": "#/$defs/id" },
                      "score": { "type": "integer", "minimum": 0 },
                      "rank": { "type": "integer", "minimum": 1, "maximum": 6 }
                    }
                  }
                },
                "winnerIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "items": { "$ref": "#/$defs/id" }
                }
              }
            }
          }
        }
      ]
    },
    "serverError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "payload"],
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "type": { "const": "error" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "retryable"],
          "properties": {
            "code": {
              "enum": [
                "INVALID_MATCH",
                "CARD_UNAVAILABLE",
                "STALE_ACTION",
                "ACTION_DUPLICATE",
                "ACTION_COOLDOWN",
                "MATCH_NOT_ACTIVE",
                "PLAYER_FORFEITED",
                "RATE_LIMITED",
                "INVALID_SESSION",
                "ROOM_FULL",
                "ROOM_LOCKED",
                "ROOM_NOT_FOUND",
                "NOT_AUTHORIZED",
                "INVALID_PAYLOAD",
                "UNSUPPORTED_VERSION",
                "INVALID_REQUEST_ID",
                "INVALID_MESSAGE_TYPE"
              ]
            },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
